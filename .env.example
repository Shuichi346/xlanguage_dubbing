# ============================================================
# xlanguage-dubbing 環境変数設定
# ============================================================

# === Hugging Faceトークン ===
HF_AUTH_TOKEN=hf_xxxxxxxxxxxx

# === パス設定 ===
VIDEO_FOLDER=./input_videos
TEMP_ROOT=./temp
OUTPUT_SUFFIX=_xlDub.mp4
KEEP_TEMP=true

# === 言語設定 ===
# INPUT_LANG: 大元の動画の音声言語。auto で ASR エンジンが自動判定
#   例: auto, en, ja, fr, de, zh, ko, es, etc.
INPUT_LANG=auto
# OUTPUT_LANG: 最終的に出力される動画の音声言語（必須・明示指定）
#   例: ja, en, fr, de, zh, ko, es, etc.
OUTPUT_LANG=ja

# === 音声設定 ===
TTS_SAMPLE_RATE=48000
TTS_CHANNELS=2
# 話者ごとに1つのネイティブ言語の音声を生成し、それをすべてのセリフに適用（クローン）します。
# 対応言語: OUTPUT_LANG=ja/en（Irodori-TTS-v4.1-Small-MFは日本語のみ対応）。
# 年齢・性別の推定機能では、初回使用時に公式のaudEERING HF24モデルがダウンロードされます。
# ローカル環境へのONNXエクスポート（オプション）を行うには、`uv sync --extra voice-design --inexact` の実行が必要です。
# モデルが利用できない場合、話者が特定できないセリフには成人男性の音声が割り当てられます。
ENABLE_VOICE_DESIGN=false
# 異なる話者音声のセットを作成するには、このシードを変更してください。
VOICE_DESIGN_SEED=42
AGE_GENDER_MODEL_DIR=./models/age-gender
# ENABLE_AUDIO_SEPARATION=false のときだけ元音声ミックスに使用。
# ENABLE_AUDIO_SEPARATION=true の背景音声は 1.00 で合成。
ORIGINAL_VOLUME=0.10
DUBBED_VOLUME=1.00
OUTPUT_SIZE=720

# ============================================================
# ASR（音声認識）
# ============================================================

# ASR エンジン: vibevoice（デフォルト）、whisper、nemo-speech（文字起こし＋最大8人の話者分離）
ASR_ENGINE=vibevoice

# --- Demucs 音声分離設定（true: vocals/no_vocals を使用、false: 元音声を使用）---
ENABLE_AUDIO_SEPARATION=true
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=mps

# --- whisper.cpp 設定（ASR_ENGINE=whisper のとき使用）---
WHISPER_MODEL=large-v3-turbo
# WHISPER_LANG は INPUT_LANG=auto のとき auto になる。明示指定も可能。
WHISPER_LANG=auto
VAD_MODEL=silero-v6.2.0
WHISPER_CPP_DIR=./whisper.cpp

# --- VibeVoice-ASR 設定（ASR_ENGINE=vibevoice のとき使用）---
VIBEVOICE_MODEL=mlx-community/VibeVoice-ASR-8bit
VIBEVOICE_MAX_TOKENS=32768
VIBEVOICE_CONTEXT=

# --- NeMo-Speech.cpp 設定（ASR_ENGINE=nemo-speech のとき使用）---
# インストール済みの CLI を使用。PATH にない場合は ~/.local/bin も探索。
# 必要に応じて NEMO_SPEECH_BIN に実行ファイルの絶対パスを指定。
# モデルは初回のみ CLI が取得し、以降は CLI のキャッシュを利用。
NEMO_SPEECH_BIN=nemo-speech
NEMO_SPEECH_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
NEMO_SPEECH_DIAR_MODEL=nvidia/Nemotron-3-Diarization
# Apple Silicon は metal、CPU は cpu。話者分離は最大8人。
NEMO_SPEECH_DEVICE=metal

# ============================================================
# 話者分離（pyannote.audio）
# ============================================================

PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# ============================================================
# セグメント加工
# ============================================================

MIN_SEGMENT_SEC=0.35
MERGE_MAX_SEC=12.0
MERGE_MAX_CHARS=320
MERGE_GAP_SEC=0.85
MERGE_FORCE_IF_VERY_SHORT_SEC=0.70

SPACY_MODEL=en_core_web_sm
SPACY_CHUNK_MAX_SEC=18.0
SPACY_CHUNK_MAX_CHARS=1100
SPACY_CHUNK_GAP_SEC=1.0
SPACY_UNIT_MAX_SENTENCES=2
SPACY_UNIT_MERGE_MAX_CHARS=300
SPACY_UNIT_MERGE_MAX_GAP_SEC=1.20
SPACY_MIN_WEIGHT=1

# ============================================================
# 翻訳
# ============================================================

# PLaMo 3 Translate 8B Q4_K_M (all 53 supported languages)
# Model: pfnet/plamo-3-translate-8b-GGUF / plamo-3-translate-8b-Q4_K_M.gguf
PLAMO_TRANSLATE_SERVER_BIN=llama-server
PLAMO_TRANSLATE_N_GPU_LAYERS=-1
PLAMO_TRANSLATE_N_CTX=8192
PLAMO_TRANSLATE_RETRIES=3
PLAMO_TRANSLATE_RETRY_BACKOFF_SEC=1.5
PLAMO_TRANSLATE_REPEAT_PENALTY=1.0

# --- 翻訳異常検出 ---
OUTPUT_REPEAT_THRESHOLD=3
INPUT_REPEAT_THRESHOLD=4

# ============================================================
# TTS（音声合成）
# ============================================================

# TTS エンジン:
#   omnivoice（デフォルト）
#   voxcpm2（VoxCPM2 — 2B、30言語・48kHz）
#   irodori（Irodori-TTS-v4.1-Small-MF、日本語専用。）
TTS_ENGINE=omnivoice

# --- OmniVoice 設定（TTS_ENGINE=omnivoice のとき使用）---
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DTYPE=float32
OMNIVOICE_NUM_STEP=32
OMNIVOICE_GUIDANCE_SCALE=2.0
OMNIVOICE_SPEED=1.0
OMNIVOICE_DURATION_SCALE=1.15
OMNIVOICE_REFERENCE_MIN_SEC=3.0
OMNIVOICE_REFERENCE_MAX_SEC=15.0
OMNIVOICE_REFERENCE_TARGET_SEC=8.0
OMNIVOICE_DURATION_TOLERANCE=0.5
OMNIVOICE_QUALITY_RETRIES=1

# --- VoxCPM2 設定（TTS_ENGINE=voxcpm2 のとき使用）---
# Controllable Cloning モード（セグメント単位の参照音声のみ）
VOXCPM2_MODEL=openbmb/VoxCPM2
VOXCPM2_CFG_VALUE=2.0
VOXCPM2_INFERENCE_TIMESTEPS=20
VOXCPM2_DURATION_SCALE=1.15
VOXCPM2_REFERENCE_MIN_SEC=3.0
VOXCPM2_REFERENCE_MAX_SEC=30.0
VOXCPM2_REFERENCE_TARGET_SEC=10.0
VOXCPM2_DURATION_TOLERANCE=0.5
VOXCPM2_QUALITY_RETRIES=1

# --- Irodori-TTS-Server 設定（TTS_ENGINE=irodori のとき使用）---
# 事前準備:
#   bash scripts/setup_irodori.sh
# Uses the pinned nonWatermark server fork and its locked inference fork.
# Irodori-TTS-v4.1-Small-MF は日本語専用TTSモデル。
# このリポジトリでは英語→日本語の吹き替えジョブのみ推奨。
# 同一話者の複数の短い発話を個別に潜在化し、最大120秒まで連結する。
# 潜在は短命プロセスで一度だけ生成・キャッシュし、irodori.ref_latent として送る。
# 48kHz mono / FP32 / deterministic encode / normalize_db=-16.0 は固定。
# Caption / Style Prompt と固定 seconds は送信しない。
IRODORI_TTS_SERVER_HOST=0.0.0.0
IRODORI_TTS_SERVER_PORT=8088
IRODORI_TTS_BASE_URL=http://localhost:8088
IRODORI_TTS_DIR=./Irodori-TTS-Server-nonWatermark
IRODORI_TTS_AUTO_START=true
IRODORI_TTS_START_COMMAND=
IRODORI_TTS_START_TIMEOUT_SEC=300
IRODORI_TTS_REQUEST_TIMEOUT_SEC=600
IRODORI_TTS_API_KEY=
IRODORI_TTS_MODEL=irodori-tts
IRODORI_HF_CHECKPOINT=Aratako/Irodori-TTS-v4.1-Small-MF
IRODORI_CODEC_REPO=Aratako/Semantic-DACVAE-Japanese-32dim
IRODORI_MODEL_DEVICE=cpu
IRODORI_CODEC_DEVICE=cpu
IRODORI_TTS_RESPONSE_FORMAT=wav
IRODORI_TTS_SPEED=1.0
# MeanFlow uses 4 steps; RF-only Sway/CFG controls are omitted from requests.
IRODORI_TTS_NUM_STEPS=4
IRODORI_TTS_T_SCHEDULE_MODE=linear
IRODORI_TTS_SWAY_COEFF=-1.0
IRODORI_REFERENCE_MAX_SEC=120.0
